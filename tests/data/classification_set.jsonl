// ── T 组：投顾语域（2026-08-15 新增 24 条）────────────────────────────────
// 玩家从"同群的陌生人"改成"老陈的投资顾问"之后，真实输入的分布变了：
// 他会说"按规定我不能替您做决定"、"您开户时备注写的是孩子婚房"、"我干这行十几年"。
// 原来的 76 条一条都没覆盖到这个语域——判的是手法不是身份，所以旧样本仍然有效，
// 但新语域里有几类**只有投顾才会踩的坑**，必须单独标：
//   · 拿从业年限当理由（与"王老师带了三个月"是同一种诉诸权威）
//   · 合规免责的外壳套着说教的内核
//   · 手里有开户资料，于是更容易"替他喊用途"（素材对了，动作错了）
// 权重偏向两个最弱的类：expose_contradiction（原本只有 10 条，且是唯一塌过的）
// 与 false_friend（原本只有 6 条）。
{"id": "T01", "tag": "plain", "sid": "chen", "context": "王老师说了，这次操作要统一转到指定账户。", "utterance": "那个统一账户，开户名是公司还是个人？您在我们这儿转账，收款方从来都是对公户。", "hits": ["expose_contradiction"], "grounded": true, "note": "「指定账户」对「正规户从不收私人卡」，两边打架；虽是问句，判据是有没有东西在打架（约定 2）"}
{"id": "T02", "tag": "tricky_wording", "sid": "chen", "context": "我账上还有两万八摆在那儿，一分不少。", "utterance": "账面上是两万八，可今天划出去的是十万。这两个数您对过没有？", "hits": ["expose_contradiction"], "grounded": true, "note": "账面数字对实际划出的数字。投顾独有的矛盾素材——他看得到流水"}
{"id": "T03", "tag": "plain", "sid": "chen", "context": "王老师从来没跟我要过一分钱手续费。", "utterance": "他一分钱不收，却要您把钱打到他指定的账户。这两件事您摆到一起看过吗？", "hits": ["expose_contradiction"], "grounded": true, "note": "「不收费」对「要你打钱」，取自上一轮的具体说法"}
{"id": "T04", "tag": "tricky_wording", "sid": "chen", "context": "我跟了老师三个月了，比你懂。", "utterance": "跟了三个月的人，上周还问我银证转账最晚几点。真摸熟了的话，这个不用问我。", "hits": ["expose_contradiction"], "grounded": true, "note": "「比你懂」对「上周还来问最基础的操作」——投顾手里的交互记录是他独有的矛盾素材"}
{"id": "T05", "tag": "plain", "sid": "chen", "context": "老师说这波稳赚，让我别怕。", "utterance": "稳赚的话，为什么还要您签那份免责协议？稳赚和免责，这两个词是打架的。", "hits": ["expose_contradiction"], "grounded": true, "note": "「稳赚」对「免责协议」，末句把矛盾点破"}
{"id": "T06", "tag": "plain", "sid": "chen", "context": "群里天天有人晒赚钱的截图。", "utterance": "群里都在晒赚，可您今天是往外划钱，不是往里转。真赚着的人，钱是往里走的。", "hits": ["expose_contradiction"], "grounded": true, "note": "「群里晒赚」对「你在往外划」"}
{"id": "T07", "tag": "plain", "sid": "chen", "context": "他们是正规公司，有营业执照的。", "utterance": "正规公司会让客户把钱打进个人账户吗？您这些年在我这儿走的每一笔，收款方都是对公的。", "hits": ["expose_contradiction"], "grounded": true, "note": "「正规公司」对「打个人账户」"}
{"id": "T08", "tag": "tricky_wording", "sid": "chen", "context": "这钱我早就想好了，就等今天。", "utterance": "想好了三个月的事，为什么非要卡在今天下午三点之前？想清楚的人不怕多等一天。", "hits": ["expose_contradiction"], "grounded": true, "note": "「早想好了」对「一天都等不了」"}
{"id": "T09", "tag": "false_friend", "sid": "any", "context": "我自己的钱我自己有数。", "utterance": "我干这行十几年了，这种局我一年见十几个。您听我的没错。", "hits": ["bare_assertion"], "grounded": false, "note": "投顾最容易脱口而出的一句：拿从业年限当理由。年限不是理由——它和「王老师带了三个月」是同一种诉诸权威"}
{"id": "T10", "tag": "false_friend", "sid": "chen", "context": "那你说我该怎么办。", "utterance": "按规定我不能给您任何买卖建议。我只能告诉您，监管去年通报的非法荐股案子有多少起、涉案多少亿，这些都是公开数据，您自己查得到。", "hits": ["preach"], "grounded": true, "note": "合规免责的外壳，说教摆数据的内核。前半句是对的（只能问不能荐），后半句把他变成了听众"}
{"id": "T11", "tag": "false_friend", "sid": "chen", "context": "这钱怎么花是我的事。", "utterance": "您这笔钱三年前进来的时候，备注写的是孩子婚房。您自己写的，现在拿去打水漂？", "hits": ["scold"], "grounded": false, "note": "素材对了，动作错了：开户留痕是投顾独有的好素材，但「拿去打水漂」把它变成了责骂。anchor 是让他自己说出用途"}
{"id": "T12", "tag": "false_friend", "sid": "chen", "context": "老师说的票从来没错过。", "utterance": "从来没错过？您把交割单发我看一眼，我保证上面全是亏的。", "hits": ["bare_assertion"], "grounded": true, "note": "前半句是提问，后半句自己把答案说了——问句的外壳，断言的内核"}
{"id": "T13", "tag": "false_friend", "sid": "chen", "context": "我提过一次八千，第二天就到账了。", "utterance": "八千是他们放给您的饵，这套流程我闭着眼都知道下一步是什么。", "hits": ["bare_assertion"], "grounded": true, "note": "「我闭着眼都知道」不构成任何理由，与 D 组「这种事我见得多了」同病"}
{"id": "T14", "tag": "false_friend", "sid": "any", "context": "你别管了行不行。", "utterance": "您这么大岁数了，怎么连这点判断力都没有？", "hits": ["scold"], "grounded": false, "note": "投顾对客户说这句更伤——他不只是被否定，还是当着给自己开户的人被否定"}
{"id": "T15", "tag": "plain", "sid": "any", "context": "我这钱放着也是放着。", "utterance": "这笔钱当初进来的时候，您是打算派什么用场？", "hits": ["anchor_real_purpose"], "grounded": false, "note": "标准 anchor，投顾语域。上一轮没有可引用的具体成分，因此未扎根"}
{"id": "T16", "tag": "plain", "sid": "any", "context": "转出去的钱周一就能回来。", "utterance": "周一回来的话，是回到哪张卡上？您现在能不能问他要一句书面的？", "hits": ["socratic_question"], "grounded": true, "note": "取自上一轮的「周一」，引导他自己去验证"}
{"id": "T17", "tag": "tricky_wording", "sid": "chen", "context": "钱的事你别操心，我心里有数。", "utterance": "我不操心钱。我就问一句——这笔钱要是三个月后才回得来，家里有哪件事会卡住？", "hits": ["anchor_real_purpose"], "grounded": true, "note": "没直接问「这钱干什么用的」，做的却是同一件事：把抽象的钱拉回具体的生活安排，且让他自己说"}
{"id": "T18", "tag": "plain", "sid": "chen", "context": "我今天下午三点前必须转。", "utterance": "您说的三点，是收盘那个三点吗？", "hits": [], "grounded": true, "note": "纯粹澄清事实，没有指向让他自己发现问题——与 G 组「那个群叫什么名字」同类"}
{"id": "T19", "tag": "plain", "sid": "chen", "context": "我跟了三个月了，你现在跳出来说这个。", "utterance": "我早提醒过您别碰不熟的东西，您当时怎么不听？现在好了。", "hits": ["scold"], "grounded": true, "note": "「我早说过」是投顾最容易脱口而出的一句，它做的是责备，不是劝阻"}
{"id": "T20", "tag": "plain", "sid": "chen", "context": "那你说这种事怎么分辨。", "utterance": "非法荐股一般五个特征：一，承诺收益；二，要求转私人账户；三，用免责协议规避；四，制造时间压力；五，群里有托配合。您对照着看。", "hits": ["preach"], "grounded": true, "note": "内容全对，形式是上课。他要的是台阶，不是知识点"}
{"id": "T21", "tag": "parrot", "sid": "chen", "context": "王老师带我三个月了，一直挺好。", "utterance": "陈叔，作为您的投资顾问，我有义务提醒您：这笔资金的用途，您考虑清楚了吗？", "hits": ["anchor_real_purpose"], "grounded": false, "note": "套着投顾身份的模板句，能原样贴到任何一段对话上——身份不构成扎根"}
{"id": "T22", "tag": "parrot", "sid": "chen", "context": "群里几百号人都在跟。", "utterance": "我们不妨回到最初的问题：您希望这笔钱最终帮您实现什么？", "hits": ["anchor_real_purpose"], "grounded": false, "note": "话术手册里的原句，与上一轮说了什么毫无关系"}
{"id": "T23", "tag": "parrot", "sid": "chen", "context": "我提过一次八千，到账了。", "utterance": "您有没有想过，这件事情背后可能存在的风险？", "hits": ["socratic_question"], "grounded": false, "note": "漂亮的提问，能贴到任何对话上。是钥匙，但未扎根——0.45 倍就是给这种句子准备的"}
{"id": "T24", "tag": "parrot", "sid": "any", "context": "这钱是我自己的。", "utterance": "站在专业的角度，我建议您再评估一下这个决策的风险收益比。", "hits": [], "grounded": false, "note": "一句正确的废话：既没问出任何东西，也没构成失误。空标签样本要够，否则模型会倾向于「总得判点什么」"}

// ── R 组：合规红线（2026-08-17 新增 16 条）─────────────────────────────────
// 判分闭集在此之前一条合规违规都没有，而这套判分表自称的根基正是
// 「只能问，不能荐」。玩家打出「您把钱转回来买我们的稳健理财，年化 4% 保本」
// ——真实投顾职业生涯里最危险的一句话——旧闭集判 0 分。
//
// 这一组要教会分类器的是**一条线，不是一种语气**：
//   · unlicensed_advice 判的是"有没有给出方向或标的"，与他说得客气不客气无关
//   · guaranteed_return 判的是"有没有对收益或本金打包票"
//   · 两者可以同时出现（R05/R06），也可以与话术失误并存（R03/R12）
//
// **R09–R16 是这一组的重点，全是 false_friend**：合规红线最容易误判的方向
// 是"沾到钱和标的就报警"。复述老陈自己说的那只票、提示风险而不给方向、
// 说"我不能给您荐股"——这三种恰恰是正确动作，误判它们等于直接惩罚正确答案。
// 这个方向上宁可漏，不可误伤（与注入吸收同一条原则）。
{"id": "R01", "tag": "plain", "sid": "chen", "context": "王老师说那只票今天必须进，晚了就没这个价了。", "utterance": "那票您别买了，真想做就买点大银行的股票，稳当。", "hits": ["unlicensed_advice"], "grounded": true, "note": "给出了具体方向和标的类别，标准的无证荐股。接住了「那只票」所以扎根"}
{"id": "R02", "tag": "plain", "sid": "chen", "context": "我账上就剩两万八了，不够本了。", "utterance": "您把钱转回来，我们这儿有个稳健型的理财，比您现在这么折腾强。", "hits": ["unlicensed_advice"], "grounded": false, "note": "推荐自家产品，同样是给方向。这是销售型投顾最容易脱口而出的一句"}
{"id": "R03", "tag": "plain", "sid": "any", "context": "你少管我，我自己有数。", "utterance": "我这是为您好，听我的把仓位清了，剩下的钱买国债逆回购去。", "hits": ["unlicensed_advice"], "grounded": false, "note": "合规红线与话术失误并存：既荐了标的，又是一句居高临下的说教"}
{"id": "R04", "tag": "tricky_wording", "sid": "chen", "context": "那只票王老师说下周能翻倍。", "utterance": "那个板块我不看好，您现在该做的是出来，换个方向。", "hits": ["unlicensed_advice"], "grounded": true, "note": "没有点名标的，但给了明确的涨跌判断和操作方向——荐股不必指名道姓"}
{"id": "R05", "tag": "plain", "sid": "chen", "context": "我这三个月赚了两万三，你懂什么。", "utterance": "您把钱交给我打理，我保证一年下来比您这么弄稳当得多，本金绝对不会亏。", "hits": ["unlicensed_advice", "guaranteed_return"], "grounded": false, "note": "两条红线一起踩：既拉客户资金又承诺保本。单轮最重的一句"}
{"id": "R06", "tag": "tricky_wording", "sid": "any", "context": "那我这钱放着不动，图什么呢。", "utterance": "放我们这儿买货基，一年四个点跑不掉的，稳赚不赔。", "hits": ["unlicensed_advice", "guaranteed_return"], "grounded": true, "note": "「跑不掉」「稳赚不赔」是承诺收益的口语形态，不必出现「保证」二字"}
