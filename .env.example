# 复制为 .env 后填写。.env 已被 .gitignore 排除，绝不可提交入库。

# ── 服务 ────────────────────────────────────────────────────
# 平台强制固定端口，请勿修改
PORT=21818
LOG_LEVEL=INFO
# 生产环境保持 false：暴露 /docs 会被安全扫描告警
ENABLE_DOCS=false

# ── 允许哪些页面把本作品嵌进 iframe（选填，默认谁都不许）──────────────────
#
# 留空 = `frame-ancestors 'none'` + `X-Frame-Options: DENY`，与 8-18 加安全头
# 时的行为逐字节相同。
#
# **什么时候要填**：大赛作品详情页有一个「作品展示」页签，而《作品规范》要求
# 「桌面端作品需同时提供可嵌入网页的 Web 展示方案」——如果那一栏是 iframe，
# 不填这一项，投票用户在展示页上看到的会是一块空白。
#
# 填法是空格分隔的 origin 列表，**只填大赛平台那一个**，别填 *：
#   FRAME_ANCESTORS="'self' https://竞赛平台域名"
#
# **整个值必须用双引号包住这一条不是排版建议，是硬要求**（2026-08-31 实测
# 踩过）：start.sh 用 bash 的 `. "${ENV_FILE}"` 直接 source 这个文件，
# 而 `KEY='self' https://x`（没有外层双引号）在 bash 眼里是
# 「赋值 KEY='self'，接一条新命令 https://x」——变量只会拿到 `self`，
# 域名部分被当成命令去执行，报 "no such file or directory"，
# CSP 头会悄悄退回 frame-ancestors 'none'，`build_security_headers()`
# 的单测测不出这个坑，因为它是直接传字符串调用，从没真的走过 bash source 这一步。
#
# 填了之后 X-Frame-Options 会被整条撤掉（它只认单一 origin，留着会打架），
# Cross-Origin-Resource-Policy 一并放宽到 cross-origin（它也拦 iframe 导航）。
FRAME_ANCESTORS=

# ── 大模型 Provider ─────────────────────────────────────────
# **只能是 internal 或 public，写错的话服务直接拒绝启动。**
#
# 这一条 2026-08-23 从"其余任何值都落到 PUBLIC_*"改成了闭集。原因是
# `LLM_PROVIDER=internla` 这一个字母的手滑，会让服务安安静静地起来、
# 健康检查一路绿、然后把每一句用户输入发到公网上——日志里没有一行
# 说过它换了供应商。金融数据的处理边界不能由拼写决定。
#
#   internal = 内网模型网关
#   public   = 公网模型接口（内网网段不可达时的保底方案）
#
# 拿到服务器后先在机器上 `curl localhost:21818/healthz?probe=1` 判断该选哪个。
# **probe 只对本机开放**（或带上 HEALTH_PROBE_TOKEN），见本文件末尾。
LLM_PROVIDER=internal

# 内网网关
INTERNAL_LLM_BASE_URL=
INTERNAL_LLM_API_KEY=
INTERNAL_LLM_MODEL=
# 走哪套协议：openai（ChatCompletions）或 anthropic（Messages）。
# **同样是闭集，写错拒绝启动。** 不从 base_url 里猜——猜错的代价是
# 上线当天报一个看不懂的 400。
INTERNAL_LLM_PROTOCOL=openai

# 公网保底（示例为 DeepSeek，按需替换）
PUBLIC_LLM_BASE_URL=https://api.deepseek.com/v1
PUBLIC_LLM_API_KEY=
PUBLIC_LLM_MODEL=deepseek-chat
PUBLIC_LLM_PROTOCOL=openai

LLM_TIMEOUT_SECONDS=30

# ── 限流（选填）────────────────────────────────────────────
# 每个来源每分钟允许开几局 / 打几轮。
#
# 接口目前**没有鉴权**（这个作品还没有宿主 App 的可信身份可用），
# 所以限流是唯一那道闸。它挡不住一个铁了心的人，但挡得住
# "一条 curl 循环把共享网关额度吃光"——而后者才是投票日真实会发生的事。
#
# 默认值按"一局最多 12 轮、一局约 3 分钟"定，正常用户够用得多。
# 设成 0 表示不限，**只在本机调试时这么做**。
# 配了 REDIS_URL 的话限流是跨进程的，否则每个 worker 各算各的。
RATE_LIMIT_START=20
RATE_LIMIT_TURN=60

# ── 健康检查探测令牌（选填）──────────────────────────────────
# `/healthz?probe=1` 会让服务从一个请求触发一次对模型网关的出站调用，
# 并把网关地址、状态码回给调用方。拿到服务器当天这是必要的排查动作，
# 但它不该是一个任何人都能打的公开接口。
#
# 放行两种：**本机来的**（ssh 上去 curl localhost），
# 或者带着对得上的 `X-Probe-Token` 头。不配这一项就只剩本机那条路。
#
# 顺带说清另外两个健康接口的分工（2026-08-23 拆开的）：
#   /healthz —— 存活。进程还在就返回 200，start.sh 用它判断服务起来没有。
#   /readyz  —— 就绪。**不能完成一局对局就返回 503**（模型没配、也没开
#               离线演示）。负载均衡该看的是这一个。
HEALTH_PROBE_TOKEN=

# ── 对局状态签名 ────────────────────────────────────────────
# 必填。对局状态由客户端持有并签名（ADR-0003），没有密钥就等于没有防线，
# 缺失时服务会拒绝启动。生成方式：python -c "import secrets;print(secrets.token_urlsafe(32))"
STATE_SIGNING_SECRET=

# ── Redis（选填，旁路）──────────────────────────────────────
# 仅用于 /api/stats 的全局统计（总局数、结局占比、钥匙命中率）。
# 没配、没装 redis 包、连不上，都只让 /api/stats 返回 available:false，
# 不影响启动，也不影响任何一局对局。
#
# 格式：redis://:口令@主机:端口/0
# 大赛共享实例：redis://:口令@10.126.192.12:7001/0
#
# **口令不要写进这个文件以外的任何地方，也不要提交进仓库。**
# `.env` 已被 .gitignore 与 package.sh 双重排除。
#
# 两条与共享实例有关的事，代码里已经处理，配的时候知道就行：
#   · **库号强制为 0**（大赛硬性要求）。写成 /1 也会被 app/stats.py 改回 /0
#     并在日志里留一行 WARNING —— 不会静默地把数据写进查不到的库。
#   · 键名带 `ai-antifraud-persuasion:` 前缀。共享 db0 上几十个作品挤在一起，
#     用 `stats:games` 这种通用名会和别人对撞。
#
# 部署到平台时这个文件不进 ZIP，口令要放在部署机的
#   ${AI_CREATOR_STATE_ROOT:-${XDG_STATE_HOME:-$HOME}}/.ai-antifraud-persuasion/env
# start.sh 会自动载入它（见该脚本第 2 段）。
REDIS_URL=

# ── 结局回传鉴权（选填）────────────────────────────────────────
# `POST /api/outcome/report` 的共享密钥：宿主 App / 交易系统把"24 小时后
# 这笔到底完成没有"报回来时，用请求头 `X-Outcome-Secret` 带这个值。
#
# 留空 = 端点直接返回 503，**不是静默放行**——调用方是后台系统，不是玩家
# 浏览器，没有状态令牌可用；"没配"和"配错"必须能分清楚，否则任何人都能
# 往 `/api/stats` 的 `outcomes` 那一段里注水。
# 需要 REDIS_URL 也配好，回传才有地方存；只配这一项、不配 Redis，
# 端点会鉴权通过但存储失败，返回 503（见 app/outcome.py）。
# 生成方式同 STATE_SIGNING_SECRET：python -c "import secrets;print(secrets.token_urlsafe(32))"
OUTCOME_REPORT_SECRET=

# ── 对局语料留存（选填，默认关）──────────────────────────────────────────
# 打开之后，每轮的玩家发言与模型台词会**脱敏后**写进上面那个 Redis
# （键 `ai-antifraud-persuasion:transcripts`，封顶 20000 条、留存 90 天）。
# 用途只有一个：拿真实对话去训更准的分类器。范围、脱敏、告知三件事写在
# docs/adr/0006-transcript-retention-for-the-pivot.md。
#
# **默认 false，而且要保持"打开是一个有人按下去的动作"**：
# 打开之后聊天页那句告知会自动变成带留存说明的版本（服务端下发），
# 页面上写的和服务端做的因此不会走散。没配 REDIS_URL 时这一项无效。
TRANSCRIPT_RETENTION=false

# ── 离线演示模式（选填，默认关）──────────────────────────────────────────
# 打开之后**一个网络请求都不发**：客户台词取自预置台词库（app/fallback.py），
# 分类走关键词规则（app/offline.py），而**判分一格都不打折**——七把钥匙、
# 效力矩阵、蓄势池、结局阶梯本来就是纯函数（ADR-0001）。
#
# 它是给路演与评审用的保险：2026-08-22 网关令牌被停了八个多小时，
# 而路演不会挑网关正常的那一天来。
#
# 与 ADR-0005（不做自动故障切换）不冲突：这是**启动期的显式开关**，
# 运行期照旧不自动切换任何东西。而且它藏不住——/healthz 上报着
# offline_demo=true，聊天页第一行也写着。
OFFLINE_DEMO=false

# ── MySQL ──────────────────────────────────────────────────
# **本作品不用 MySQL，因此没有这一项配置。**
#
# 大赛提供了 10.126.192.11:3306 / aicreator_7s2k9p，但这个作品是无状态的：
# 对局状态由客户端持有并签名（ADR-0003），服务端不存任何东西；
# Redis 那点计数是旁路展示，丢了也不影响对局。
# 为了"用上提供的资源"而引一个数据库，只会多一个部署期的失败点。
# 真要落库再加，那时候连接串走与 REDIS_URL 同一条通路。
