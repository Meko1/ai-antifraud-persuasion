# 复制为 .env 后填写。.env 已被 .gitignore 排除，绝不可提交入库。

# ── 服务 ────────────────────────────────────────────────────
# 平台强制固定端口，请勿修改
PORT=21818
LOG_LEVEL=INFO
# 生产环境保持 false：暴露 /docs 会被安全扫描告警
ENABLE_DOCS=false

# ── 大模型 Provider ─────────────────────────────────────────
# internal = 内网模型网关
# public   = 公网模型接口（内网网段不可达时的保底方案）
# 拿到服务器后先访问 /healthz?probe=1 判断该选哪个
LLM_PROVIDER=internal

# 内网网关（OpenAI 兼容协议）
INTERNAL_LLM_BASE_URL=
INTERNAL_LLM_API_KEY=
INTERNAL_LLM_MODEL=

# 公网保底（示例为 DeepSeek，按需替换）
PUBLIC_LLM_BASE_URL=https://api.deepseek.com/v1
PUBLIC_LLM_API_KEY=
PUBLIC_LLM_MODEL=deepseek-chat

LLM_TIMEOUT_SECONDS=30

# ── 对局状态签名 ────────────────────────────────────────────
# 必填。对局状态由客户端持有并签名（ADR-0003），没有密钥就等于没有防线，
# 缺失时服务会拒绝启动。生成方式：python -c "import secrets;print(secrets.token_urlsafe(32))"
STATE_SIGNING_SECRET=

# ── Redis（选填，旁路）──────────────────────────────────────
# 仅用于 /api/stats 的全局统计（总局数、结局占比、钥匙命中率）。
# 没配、没装 redis 包、连不上，都只让 /api/stats 返回 available:false，
# 不影响启动，也不影响任何一局对局。
#
# 格式：redis://:口令@主机:端口/0
# 大赛共享实例：redis://:口令@10.126.192.12:7001/0
#
# **口令不要写进这个文件以外的任何地方，也不要提交进仓库。**
# `.env` 已被 .gitignore 与 package.sh 双重排除。
#
# 两条与共享实例有关的事，代码里已经处理，配的时候知道就行：
#   · **库号强制为 0**（大赛硬性要求）。写成 /1 也会被 app/stats.py 改回 /0
#     并在日志里留一行 WARNING —— 不会静默地把数据写进查不到的库。
#   · 键名带 `ai-antifraud-persuasion:` 前缀。共享 db0 上几十个作品挤在一起，
#     用 `stats:games` 这种通用名会和别人对撞。
#
# 部署到平台时这个文件不进 ZIP，口令要放在部署机的
#   ${AI_CREATOR_STATE_ROOT:-${XDG_STATE_HOME:-$HOME}}/.ai-antifraud-persuasion/env
# start.sh 会自动载入它（见该脚本第 2 段）。
REDIS_URL=

# ── 对局语料留存（选填，默认关）──────────────────────────────────────────
# 打开之后，每轮的玩家发言与模型台词会**脱敏后**写进上面那个 Redis
# （键 `ai-antifraud-persuasion:transcripts`，封顶 20000 条、留存 90 天）。
# 用途只有一个：拿真实对话去训更准的分类器。范围、脱敏、告知三件事写在
# docs/adr/0006-transcript-retention-for-the-pivot.md。
#
# **默认 false，而且要保持"打开是一个有人按下去的动作"**：
# 打开之后聊天页那句告知会自动变成带留存说明的版本（服务端下发），
# 页面上写的和服务端做的因此不会走散。没配 REDIS_URL 时这一项无效。
TRANSCRIPT_RETENTION=false

# ── 离线演示模式（选填，默认关）──────────────────────────────────────────
# 打开之后**一个网络请求都不发**：客户台词取自预置台词库（app/fallback.py），
# 分类走关键词规则（app/offline.py），而**判分一格都不打折**——七把钥匙、
# 效力矩阵、蓄势池、结局阶梯本来就是纯函数（ADR-0001）。
#
# 它是给路演与评审用的保险：2026-08-22 网关令牌被停了八个多小时，
# 而路演不会挑网关正常的那一天来。
#
# 与 ADR-0005（不做自动故障切换）不冲突：这是**启动期的显式开关**，
# 运行期照旧不自动切换任何东西。而且它藏不住——/healthz 上报着
# offline_demo=true，聊天页第一行也写着。
OFFLINE_DEMO=false

# ── MySQL ──────────────────────────────────────────────────
# **本作品不用 MySQL，因此没有这一项配置。**
#
# 大赛提供了 10.126.192.11:3306 / aicreator_7s2k9p，但这个作品是无状态的：
# 对局状态由客户端持有并签名（ADR-0003），服务端不存任何东西；
# Redis 那点计数是旁路展示，丢了也不影响对局。
# 为了"用上提供的资源"而引一个数据库，只会多一个部署期的失败点。
# 真要落库再加，那时候连接串走与 REDIS_URL 同一条通路。

# ── 参赛编号（选填）────────────────────────────────────────
# 印在分享卡上（§8）。没配就空着，分享卡不印那一行。
CONTEST_ID=
